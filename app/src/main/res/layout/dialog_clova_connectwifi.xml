<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="15dp"
    android:paddingTop="15dp"
    android:paddingRight="15dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textview_wifi_rssi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RSSI: 0"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/textview_wifi_encrypt_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="暗号化: 不明"
            android:textSize="16sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearlayout_wifi_password"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <EditText
            android:id="@+id/editText_wifi_password"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:ems="10"
            android:hint="パスワード"
            android:inputType="textPassword" />

        <CheckBox
            android:id="@+id/checkBox_show_wifi_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="パスワードの表示" />

    </LinearLayout>

</LinearLayout>